# ============================================================
# Redmine RAG Chatbot - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Required ---
GEMINI_API_KEY=your_gemini_api_key_here
REDMINE_URL=https://your-redmine.example.com
REDMINE_API_KEY=your_redmine_api_key_here
SECRET_KEY=change-me-to-a-random-string

# --- Vector DB (Redmine issues) ---
VECTORDB_PATH=/vectordb/chroma_db_v0.2.0
COLLECTION_NAME=redmine_issues_raw_v4
VECTORDB_HOST_PATH=./vectordb

# --- Embedding Model ---
# gemini (default) or openai
EMBEDDING_MODEL=gemini
# Required only when EMBEDDING_MODEL=openai
OPENAI_API_KEY=

# --- Vector DB (CRF clinical data - Optional) ---
# Leave empty to disable CRF engine
CRF_VECTORDB_PATH=/vectordb/crf_data/chroma_db_v0.3.0
CRF_COLLECTION_NAME=crf_all_cancers_v0.3.0
CRF_EMBEDDING_MODEL=gemini

# --- Server ---
PORT=8080
GUNICORN_WORKERS=4
LOG_LEVEL=info

# --- Admin (Optional) ---
# Comma-separated Redmine usernames with admin privileges
# e.g. ADMIN_USERS=alice,bob
ADMIN_USERS=

# --- DOCX Export ---
EXPORTS_DIR=/vectordb/exports
DOCX_MODEL=gemini-2.5-pro

# --- PaperBanana diagram generation (Optional) ---
# Leave empty to disable diagram feature
PAPERBANANA_BASE_URL=
PAPERBANANA_MAX_CONCURRENT=6

# --- Langfuse observability (Optional) ---
# Self-host Langfuse or use Langfuse Cloud
# Leave empty to disable tracing
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
